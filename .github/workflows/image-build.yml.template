# Rename to image-build.yml only after:
# 1. NIX-001 validates all image outputs;
# 2. every referenced action is pinned to a full commit SHA;
# 3. GHCR package names and permissions are approved.
name: Image build

on:
  pull_request:
    paths:
      - "nix/**"
      - "flake.nix"
      - "flake.lock"
      - "cmd/private-vm-guestd/**"
      - "api/**"
      - "policies/**"
  push:
    branches: [main]
    paths:
      - "nix/**"
      - "flake.nix"
      - "flake.lock"
      - "cmd/private-vm-guestd/**"
      - "api/**"
      - "policies/**"

permissions:
  contents: read

jobs:
  image:
    strategy:
      fail-fast: false
      matrix:
        image:
          - workstation-basic
          - workstation-office
          - workstation-development
          - downloader
          - scanner
          - exporter
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
        with:
          persist-credentials: false
      - uses: DeterminateSystems/nix-installer-action@ef8a148080ab6020fd15196c2084a2eea5ff2d25 # v22
      - name: Free workspace and report capacity
        run: |
          df -h
          free -h
      - name: Build one image
        run: nix build ".#image-${{ matrix.image }}" --print-build-logs
      - name: Boot smoke test under TCG
        run: go run ./cmd/private-vm images test --role "${{ matrix.image }}" --backend tcg

  publish:
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    needs: image
    runs-on: ubuntu-latest
    environment: image-publish
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
        with:
          persist-credentials: false
      - uses: DeterminateSystems/nix-installer-action@ef8a148080ab6020fd15196c2084a2eea5ff2d25 # v22
      - name: Package, SBOM, push and attest
        run: |
          echo "Implement REL-003: zstd, ORAS push by digest, SPDX SBOM and GitHub attestation."
          exit 1
