# Security-sensitive template. Activate only after REL-001 through REL-004 pass.
name: Release

on:
  push:
    tags: ["v*"]

permissions:
  contents: read

jobs:
  release:
    runs-on: ubuntu-latest
    environment: release
    permissions:
      contents: write
      packages: write
      id-token: write
      attestations: write
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
        with:
          persist-credentials: false
          fetch-depth: 0
      - uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6
        with:
          go-version: "1.26.5"
          cache: false
      - uses: DeterminateSystems/nix-installer-action@ef8a148080ab6020fd15196c2084a2eea5ff2d25 # v22
      - name: Verify protected clean tag
        run: private-vm release verify-tag "${GITHUB_REF_NAME}"
      - name: Build and test
        run: private-vm release prepare --all
      - name: Publish by digest
        run: private-vm release publish --attest --sbom
      - name: Anonymous clean-room verification
        run: private-vm release verify-published "${GITHUB_REF_NAME}"
