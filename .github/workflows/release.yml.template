# Security-sensitive template. Activate only after REL-001 through REL-006 pass.
name: Release

on:
  push:
    tags: ["v*"]

permissions:
  contents: write
  packages: write
  id-token: write
  attestations: write

jobs:
  release:
    runs-on: ubuntu-latest
    environment: release
    steps:
      - uses: actions/checkout@FULL_COMMIT_SHA_REQUIRED
      - uses: actions/setup-go@FULL_COMMIT_SHA_REQUIRED
        with:
          go-version: "1.26.5"
      - uses: DeterminateSystems/nix-installer-action@FULL_COMMIT_SHA_REQUIRED
      - name: Verify protected clean tag
        run: private-vm release verify-tag "${GITHUB_REF_NAME}"
      - name: Build and test
        run: private-vm release prepare --all
      - name: Publish by digest
        run: private-vm release publish --attest --sbom
      - name: Anonymous clean-room verification
        run: private-vm release verify-published "${GITHUB_REF_NAME}"
