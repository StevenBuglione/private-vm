<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>private-vm</vendor>
  <vendor_url>https://github.com/StevenBuglione/private-vm</vendor_url>

  <action id="org.private-vm.usb.prepare">
    <description>Prepare an enrolled USB device</description>
    <message>Authentication is required to erase and prepare the selected USB device.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
