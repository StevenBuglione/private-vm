{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private-vm.dev/schema/cli-event-v1.json",
  "title": "private-vm CLI event envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "ok": { "const": true },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "session_id": {
      "type": "string",
      "pattern": "^pvm-[a-f0-9]{32}$"
    },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/progress" },
        { "$ref": "#/$defs/state_change" }
      ]
    }
  },
  "required": ["schema_version", "ok", "code", "sequence", "data"],
  "$defs": {
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["current", "total", "unit"]
    },
    "state_change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "timestamp": { "type": "string", "format": "date-time" },
        "progress": { "$ref": "#/$defs/progress" },
        "display_label": { "type": "string", "maxLength": 256 }
      },
      "required": ["state", "message", "timestamp"]
    }
  }
}
