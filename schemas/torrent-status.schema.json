{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StevenBuglione/private-vm/schemas/torrent-status.schema.json",
  "title": "private-vm redacted torrent workflow status",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "state": {
      "enum": [
        "EMPTY",
        "METADATA_FETCHING",
        "FILE_SELECTION_REQUIRED",
        "CAPACITY_VERIFIED",
        "DOWNLOADING",
        "DOWNLOAD_PAUSED",
        "DOWNLOAD_COMPLETE",
        "QUARANTINE_SEALING",
        "QUARANTINE_SEALED"
      ]
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completed_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      },
      "required": ["completed_bytes", "total_bytes"]
    },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "remediation": { "type": "string", "minLength": 1, "maxLength": 512 }
  },
  "required": ["schema_version", "state", "progress", "code", "remediation"]
}
