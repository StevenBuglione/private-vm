{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private-vm.dev/schema/cli-success-v1.json",
  "title": "private-vm CLI success envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "ok": { "const": true },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "data": { "type": "object" }
  },
  "required": ["schema_version", "ok", "code", "data"],
  "oneOf": [
    {
      "properties": {
        "code": { "const": "VERSION_REPORTED" },
        "data": { "$ref": "#/$defs/version" }
      }
    },
    {
      "properties": {
        "code": { "const": "DOCTOR_REPORT" },
        "data": { "$ref": "#/$defs/doctor" }
      }
    },
    {
      "properties": {
        "code": { "const": "ACKNOWLEDGED" },
        "data": { "$ref": "#/$defs/acknowledgement" }
      }
    },
    {
      "properties": {
        "code": { "const": "VPN_PROFILE_STATUS" },
        "data": { "$ref": "#/$defs/vpn_status" }
      }
    },
    {
      "properties": {
        "code": { "const": "SESSION_STATUS" },
        "data": { "$ref": "#/$defs/session_status" }
      }
    },
    {
      "properties": {
        "code": { "const": "WORKSPACE_STATUS" },
        "data": { "$ref": "#/$defs/workspace_status" }
      }
    },
    {
      "properties": {
        "code": { "const": "TORRENT_STATUS" },
        "data": { "$ref": "#/$defs/torrent_status" }
      }
    },
    {
      "properties": {
        "code": { "const": "SCANNER_STATUS" },
        "data": { "$ref": "#/$defs/scanner_status" }
      }
    }
  ],
  "$defs": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "commit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "date": { "type": "string", "minLength": 1, "maxLength": 64 },
        "go_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "os": { "type": "string", "minLength": 1, "maxLength": 64 },
        "arch": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["version", "commit", "date", "go_version", "os", "arch"]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "severity": { "enum": ["info", "warning", "blocking"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "overridable": { "type": "boolean" }
      },
      "required": ["code", "severity", "summary", "overridable"]
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runnable": { "type": "boolean" },
        "diagnostics": {
          "type": "array",
          "maxItems": 512,
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      },
      "required": ["runnable", "diagnostics"]
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["message"]
    },
    "vpn_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "present": { "type": "boolean" },
        "generation": { "type": "integer", "minimum": 0 },
        "rotation": { "enum": ["not_imported", "resolution_required", "current", "rotation_required"] },
        "code": { "enum": ["VPN_PROFILE_NOT_IMPORTED", "VPN_ENDPOINT_CHECK_REQUIRED", "VPN_PROFILE_CURRENT", "VPN_PROFILE_ROTATION_REQUIRED"] },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 256 },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": { "const": 1 },
            "ipv4_enabled": { "const": true },
            "ipv6_enabled": { "type": "boolean" },
            "interface_address_count": { "type": "integer", "minimum": 1, "maximum": 8 },
            "dns_server_count": { "type": "integer", "minimum": 1, "maximum": 8 }
          },
          "required": ["schema_version", "ipv4_enabled", "ipv6_enabled", "interface_address_count", "dns_server_count"]
        }
      },
      "required": ["schema_version", "present", "generation", "rotation", "code", "remediation"],
      "allOf": [
        {
          "if": { "properties": { "present": { "const": true } }, "required": ["present"] },
          "then": { "required": ["profile"], "properties": { "generation": { "minimum": 1 } } },
          "else": {
            "not": { "required": ["profile"] },
            "properties": {
              "generation": { "const": 0 },
              "rotation": { "const": "not_imported" },
              "code": { "const": "VPN_PROFILE_NOT_IMPORTED" }
            }
          }
        }
      ]
    },
    "session_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/session" }
        }
      },
      "required": ["sessions"]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^pvm-[a-f0-9]{32}$" },
        "role": { "enum": ["workstation", "downloader", "scanner", "exporter"] },
        "phase": { "enum": ["CREATED", "PREFLIGHTED", "IMAGES_VERIFIED", "STORAGE_READY", "ACTIVE", "STOPPING", "ABORTING", "DESTROYING", "DESTROYED"] },
        "workflow_state": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
      },
      "required": ["id", "role", "phase"]
    },
    "workspace_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "state": { "enum": ["CLEAN", "READY", "UNEXPORTED", "CHANGED"] },
        "file_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "exported_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "unexported_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "changed_count": { "type": "integer", "minimum": 0, "maximum": 1024 }
      },
      "required": ["schema_version", "state", "file_count", "exported_count", "unexported_count", "changed_count"]
    },
    "torrent_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "state": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "completed_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 },
        "file_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "selected_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "payload_paused": { "type": "boolean" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["schema_version", "state", "completed_bytes", "total_bytes", "file_count", "selected_count", "payload_paused", "code", "remediation"]
    },
    "scanner_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "session_id": { "type": "string", "pattern": "^pvm-[a-f0-9]{32}$" },
        "destination_session_id": { "type": "string", "pattern": "^pvm-[a-f0-9]{32}$" },
        "workflow_state": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "report_complete": { "type": "boolean" },
        "decision": { "enum": ["pending", "approved", "rejected"] },
        "input_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "finding_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "blocking_finding_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "sanitized_output_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "sanitized_output_bytes": { "type": "integer", "minimum": 0 },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["schema_version", "session_id", "workflow_state", "report_complete", "decision", "input_count", "finding_count", "blocking_finding_count", "sanitized_output_count", "sanitized_output_bytes", "code", "remediation"]
    }
  }
}
