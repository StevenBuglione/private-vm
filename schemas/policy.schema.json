{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private-vm.dev/schema/policy-v1.json",
  "title": "private-vm content policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "enum": ["safe", "quarantine"] },
    "mode": { "enum": ["safe", "quarantine"] },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "max_single_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_archive_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "max_expansion_ratio": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "max_expanded_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "scan_timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 300
        }
      },
      "required": [
        "max_input_bytes",
        "max_single_file_bytes",
        "max_files",
        "max_archive_depth",
        "max_expansion_ratio",
        "max_expanded_bytes",
        "scan_timeout_seconds"
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reject_on_malware": { "const": true },
        "reject_on_scan_error": { "const": true },
        "reject_on_skipped_file": { "const": true },
        "reject_encrypted_archives": { "const": true },
        "block_executables": { "type": "boolean" },
        "block_scripts": { "type": "boolean" },
        "block_disk_images": { "type": "boolean" },
        "sanitize_documents": { "type": "boolean" },
        "reencode_media": { "type": "boolean" },
        "strip_metadata": { "type": "boolean" }
      },
      "required": [
        "reject_on_malware",
        "reject_on_scan_error",
        "reject_on_skipped_file",
        "reject_encrypted_archives",
        "block_executables",
        "block_scripts",
        "block_disk_images",
        "sanitize_documents",
        "reencode_media",
        "strip_metadata"
      ]
    }
  },
  "required": ["schema_version", "name", "mode", "limits", "rules"],
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "safe" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "name": { "const": "safe" },
          "rules": {
            "properties": {
              "block_executables": { "const": true },
              "block_scripts": { "const": true },
              "block_disk_images": { "const": true },
              "sanitize_documents": { "const": true },
              "reencode_media": { "const": true },
              "strip_metadata": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "quarantine" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "name": { "const": "quarantine" },
          "rules": {
            "properties": {
              "block_executables": { "const": false },
              "block_scripts": { "const": false },
              "block_disk_images": { "const": false },
              "sanitize_documents": { "const": false },
              "reencode_media": { "const": false },
              "strip_metadata": { "const": false }
            }
          }
        }
      }
    }
  ]
}
