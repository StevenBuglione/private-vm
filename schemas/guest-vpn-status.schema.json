{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StevenBuglione/private-vm/schemas/guest-vpn-status.schema.json",
  "title": "private-vm redacted guest VPN status",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "state": { "enum": ["unconfigured", "kill_switch_armed", "configured", "verified", "degraded", "stopped"] },
    "kill_switch_armed": { "type": "boolean" },
    "configured": { "type": "boolean" },
    "handshake": { "type": "boolean" },
    "dns_through_tunnel": { "type": "boolean" },
    "dns_bypass_blocked": { "type": "boolean" },
    "ipv4_through_tunnel": { "type": "boolean" },
    "ipv6_through_tunnel": { "type": "boolean" },
    "ipv4_bypass_blocked": { "type": "boolean" },
    "ipv6_bypass_blocked": { "type": "boolean" },
    "torrent_bound": { "type": "boolean" },
    "code": { "enum": ["GUEST_VPN_UNCONFIGURED", "GUEST_VPN_NOT_VERIFIED", "GUEST_VPN_VERIFIED", "GUEST_VPN_DEGRADED", "GUEST_VPN_STOPPED"] },
    "remediation": { "type": "string", "minLength": 1, "maxLength": 512 }
  },
  "required": [
    "schema_version", "state", "kill_switch_armed", "configured", "handshake",
    "dns_through_tunnel", "dns_bypass_blocked", "ipv4_through_tunnel", "ipv6_through_tunnel",
    "ipv4_bypass_blocked", "ipv6_bypass_blocked", "torrent_bound", "code", "remediation"
  ],
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "verified" } }, "required": ["state"] },
      "then": {
        "properties": {
          "kill_switch_armed": { "const": true },
          "configured": { "const": true },
          "handshake": { "const": true },
          "dns_through_tunnel": { "const": true },
          "dns_bypass_blocked": { "const": true },
          "ipv4_through_tunnel": { "const": true },
          "ipv4_bypass_blocked": { "const": true },
          "ipv6_bypass_blocked": { "const": true },
          "code": { "const": "GUEST_VPN_VERIFIED" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "enum": ["unconfigured", "stopped"] } }, "required": ["state"] },
      "then": { "properties": { "kill_switch_armed": { "const": false }, "configured": { "const": false } } }
    }
  ]
}
