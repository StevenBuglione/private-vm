{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private-vm.dev/schema/scanner-toolchain-v1.json",
  "title": "private-vm scanner toolchain identity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "const": "private-vm" },
    "role": { "const": "scanner" },
    "architecture": { "enum": ["x86_64", "aarch64"] },
    "source_commit": {
      "type": "string",
      "pattern": "^(unknown|[0-9a-f]{40}(-dirty)?)$"
    },
    "flake_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_execution_contract": {
      "const": "guestd-bounded-unprivileged-private-namespace"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "required": [
    "schema_version",
    "project",
    "role",
    "architecture",
    "source_commit",
    "flake_lock_sha256",
    "archive_execution_contract",
    "tools"
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9+._-]*$"
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9+._-]*$"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": ["id", "package", "version", "commands", "purpose"]
    }
  }
}
