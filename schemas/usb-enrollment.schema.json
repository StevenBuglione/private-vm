{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StevenBuglione/private-vm/schemas/usb-enrollment.schema.json",
  "title": "private-vm USB enrollment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "enrollment_id": { "type": "string", "pattern": "^usb-[0-9a-f]{16}$" },
    "label": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{0,31}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor_id": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
        "product_id": { "type": "string", "pattern": "^[0-9a-f]{4}$" },
        "serial": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]+$" },
        "usbguard_hash": { "type": "string", "pattern": "^[A-Za-z0-9+/=_-]{16,256}$" },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^08:[0-9a-f]{2}:[0-9a-f]{2}$" }
        },
        "capacity_bytes": { "type": "integer", "minimum": 1 },
        "port_path": { "type": "string", "pattern": "^[0-9]+-[0-9]+(?:\\.[0-9]+)*$" },
        "port_bound": { "type": "boolean" },
        "model": { "type": "string", "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]*$" }
      },
      "required": [
        "vendor_id",
        "product_id",
        "usbguard_hash",
        "interfaces",
        "capacity_bytes",
        "port_path",
        "port_bound"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "port_bound": { "const": false } },
            "required": ["port_bound"]
          },
          "then": { "required": ["serial"] }
        }
      ]
    },
    "filesystem": { "const": "luks2-ext4" }
  },
  "required": ["schema_version", "enrollment_id", "label", "identity", "filesystem"]
}
