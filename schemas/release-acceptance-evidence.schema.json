{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://private-vm.dev/schema/release-acceptance-evidence-v1.json",
  "title": "private-vm redacted release acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "profile", "complete", "cases"],
  "properties": {
    "schema_version": {"const": 1}, "project": {"const": "private-vm"}, "profile": {"const": "source-only"}, "complete": {"const": false},
    "cases": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "code", "duration_ms"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"}, "status": {"enum": ["passed", "failed", "blocked"]}, "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}, "duration_ms": {"type": "integer", "minimum": 0, "maximum": 3600000}}}}
  }
}
